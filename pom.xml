<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dbagent</groupId>
    <artifactId>dbagent-java</artifactId>
    <version>0.1.0</version>
    <name>dbagent-java</name>
    <description>DBAgent (Oracle DB monitoring/AI-DBA) - Java/Spring Boot port</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Oracle JDBC driver (replaces python-oracledb) -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
        </dependency>

        <!-- SQLite JDBC driver (replaces python sqlite3, for users.db / oracle_errors.db) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- MariaDB JDBC driver - also used for db_type=mysql (wire-protocol compatible with MySQL) -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.1</version>
        </dependency>

        <!-- PostgreSQL JDBC driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.4</version>
        </dependency>

        <!-- MS SQL Server JDBC driver -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>12.8.1.jre11</version>
        </dependency>

        <!-- CUBRID JDBC driver - resolved from the in-repo lib/repo (see <repositories> below),
             because CUBRID publishes no official artifact to Maven Central. -->
        <dependency>
            <groupId>cubrid</groupId>
            <artifactId>cubrid-jdbc</artifactId>
            <version>11.3.1.0050</version>
        </dependency>

        <!-- Password hashing (replaces werkzeug.security) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>23.5.0.24.07</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Project-local Maven repository, checked into git alongside the source.

      Only the CUBRID JDBC driver lives here: CUBRID does not publish to Maven Central (the only
      artifacts there are third-party republishes that stop at 10.1.x), and this app targets
      CUBRID 11.x. A <scope>system</scope> dependency would NOT work as a substitute - Spring
      Boot's repackage goal leaves system-scoped jars out of the fat jar, so the driver would be
      missing at runtime. Vendoring it this way also means `mvn clean package` still works on the
      closed-network machines with no manual `mvn install:install-file` step first.
    -->
    <repositories>
        <repository>
            <id>project-local</id>
            <name>In-repo vendored artifacts</name>
            <url>file://${project.basedir}/lib/repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
